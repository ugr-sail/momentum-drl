{
  // Entorno del curso para VS Code (Dev Containers) y GitHub Codespaces
  // Autoría: SAIL-UGR research group
  "name": "MOMENTUM · Python y DRL (by SAIL-UGR research group)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "runArgs": ["--label", "org.opencontainers.image.authors=SAIL-UGR research group"],
  "postCreateCommand": "pip install -r requirements.txt && python -m ipykernel install --user --name curso-python --display-name \"Python (curso)\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "jupyter.askForKernelRestart": false,
        "notebook.output.textLineLimit": 100,
        "workbench.startupEditor": "readme",
        "workbench.editorAssociations": {
          "*.md": "vscode.markdown.preview.editor"
        },
        "files.exclude": {
          "**/__pycache__": true,
          "**/.ipynb_checkpoints": true
        }
      }
    },
    "codespaces": {
      "openFiles": [
        "workspace/00_bienvenida.ipynb"
      ]
    }
  }
}
